# Optional environment variables. This project does not automatically load .env files.
# Set/export only the values you need: empty values are not equivalent to unset
# for all options, and can disable defaults or cause numeric parsing errors.

# OpenAI API key for cloud/mixed mode; create one at https://platform.openai.com/api-keys, or use hegemon key.
OPENAI_API_KEY=
# Full OpenAI Responses API endpoint; choose your compatible endpoint if overriding the default.
HEGEMON_OPENAI_URL=
# Cloud conversion model ID; choose a model available to your OpenAI key (default: gpt-6.1-sol).
HEGEMON_MODEL=
# Cloud ranking and file-selection model ID; choose one available to your key (default: gpt-6.1-sol).
HEGEMON_FAST_MODEL=
# Force OpenAI reasoning effort, such as medium or high; unset uses medium first and high for repairs.
HEGEMON_REASONING=
# Timeout in seconds for AI requests; choose for your provider and model (default: 900).
HEGEMON_AI_TIMEOUT=
# Maximum conversion attempts; choose an integer appropriate for your workload (default: 5).
HEGEMON_ATTEMPTS=

# Model routing: choose cloud, local, or mixed; otherwise the saved mode or cloud behavior is used.
HEGEMON_MODE=
# Base URL of your local OpenAI-compatible server, including /v1; otherwise use saved URL or localhost:11434/v1.
HEGEMON_LOCAL_URL=
# Local model ID installed on your server; otherwise use saved model or qwen2.5-coder-16k.
HEGEMON_LOCAL_MODEL=

# Directory for run output; choose a writable path, otherwise use the lab user directory or ~/hegemon-agent-runs.
HEGEMON_RUNS=
# Hegemon web installation directory for publishing; choose your site path (default: ~/public_html/Hegemon).
HEGEMON_SITE_ROOT=
# Public base URL corresponding to the site root; choose your deployment URL (default: UCSD user Hegemon URL).
HEGEMON_SITE_URL=
# Path to the lab's jupyter_gse_processing script; choose your installation if not at the notebook paths.
HEGEMON_BOOLEANLAB_SCRIPT=
# Directory containing genome gene-name tables; choose your installation if not at the notebook paths.
HEGEMON_GENOME_DIR=
# Python executable for the launcher and TUI; choose an installed interpreter with project dependencies.
HEGEMON_PYTHON=

# Per-file download size limit in decimal GB; choose a budget (default: 5).
HEGEMON_MAX_FILE_GB=
# Total download size limit in decimal GB; choose a budget (default: 20).
HEGEMON_MAX_TOTAL_GB=
# Conversion script timeout in seconds; choose for your workload (default: 14400).
HEGEMON_SCRIPT_TIMEOUT=
# Lab script timeout in seconds; choose for your workload (default: 43200).
HEGEMON_LAB_TIMEOUT=
# Number of files downloaded concurrently; choose a positive integer (default: 4; 1 is serial).
HEGEMON_DOWNLOAD_WORKERS=
# Number of byte ranges for eligible large downloads; choose a positive integer (default: 4; 1 disables splitting).
HEGEMON_DOWNLOAD_PARTS=
# Combined candidate file size in decimal MB above which AI file selection may run (default: 100).
HEGEMON_PICK_ABOVE_MB=
# Minimum table cell count for parallel writing; choose an integer threshold (default: 4000000).
HEGEMON_PARALLEL_WRITE_CELLS=
# Set to 1 to accept conversions without a grouping metadata field; otherwise grouping is required.
HEGEMON_ALLOW_UNGROUPED=
# Set to 0 to disable eligible built-in conversions and use AI instead; enabled by default.
HEGEMON_BUILTIN=
# Set to 1 to skip repository lookup when building a dataset from local/offline sources.
HEGEMON_OFFLINE=
# Set to list to check only dataset listing after publishing, skipping gene and threshold lookups; default is full.
HEGEMON_LIVE_CHECK=

# Scratch directory for tests/run_local_tests.py; choose a dedicated test path (default: /tmp/hgtest).
HEGEMON_TEST_DIR=
# Path to a clone of github.com/sahoo00/Hegemon for local publishing tests (default: /tmp/sahoo_Hegemon).
HEGEMON_PUBLIC_REPO=

# Home directory for configuration, default paths, and child scripts; normally inherited from the environment.
HOME=
# Executable search path for the launcher and child scripts; normally inherited from the environment.
PATH=
# Current shell used to select shell setup files; normally inherited from the environment.
SHELL=
# User name used for lab and site defaults; normally inherited from the environment.
USER=
# Fallback user name when USER is unset; normally inherited from the environment.
USERNAME=
